{
  "schemaVersion": 2,
  "minimumEngineVersion": "2.0.0",
  "id": "pazulu.kingofshojo",
  "name": "KingofShojo",
  "version": "1.0.0",
  "languages": [
    "en"
  ],
  "contentTypes": [
    "manhwa",
    "manga"
  ],
  "hosts": [
    "kingofshojo.com"
  ],
  "capabilities": {
    "search": true,
    "chapters": true,
    "pages": true,
    "latest": true
  },
  "transport": "browser",
  "html": {
    "family": "mangathemesia"
  },
  "paginationMode": "auto",
  "readingDirection": "auto",
  "imageMode": "referer",
  "rateLimit": {
    "requestsPerMinute": 20,
    "maxConcurrent": 1
  },
  "validation": "IMPLEMENTED_UNTESTED",
  "enabledByDefault": false,
  "notes": "Profil famille MangaThemesia. Non testé en réel."
}